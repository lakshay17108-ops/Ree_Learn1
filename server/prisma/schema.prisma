generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String             @id @default(uuid())
  name         String
  email        String             @unique
  passwordHash String
  role         String             // PRINCIPAL | TEACHER | STUDENT
  approvalStatus String           @default("APPROVED")
  approvedAt   DateTime?
  approvedById String?
  avatarUrl    String?
  createdAt    DateTime           @default(now())
  
  classroomsCreated Classroom[]   @relation("TeacherClassrooms")
  classEnrollments  ClassEnrollment[]
  quizzesCreated    Quiz[]
  assignments       Assignment[]
  quizAttempts      QuizAttempt[]
  studentAnswers    StudentQuestionAnswer[]
  revisionPosts     RevisionPost[]        @relation("RevisionPostAuthor")
  revisionActions   RevisionInteraction[]
  revisionReviews   RevisionReview[]
  meetingsCreated   Meeting[]           @relation("MeetingCreator")
  meetingInvites    Meeting[]           @relation("MeetingRecipient")

  @@map("users")
}

model Classroom {
  id          String             @id @default(uuid())
  name        String
  section     String
  joinCode    String             @unique
  teacherId   String
  teacher     User               @relation("TeacherClassrooms", fields: [teacherId], references: [id], onDelete: Cascade)
  createdAt   DateTime           @default(now())

  enrollments ClassEnrollment[]
  subjects    Subject[]
  assignments Assignment[]
  meetings     Meeting[]

  @@map("classrooms")
}

model ClassEnrollment {
  id          String    @id @default(uuid())
  classroomId String
  studentId   String
  enrolledAt  DateTime  @default(now())

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student     User      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classroomId, studentId])
  @@map("class_enrollments")
}

model Subject {
  id          String    @id @default(uuid())
  classroomId String
  name        String
  code        String

  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  questions   Question[]
  quizzes     Quiz[]
  revisionPosts RevisionPost[]

  @@map("subjects")
}

model Question {
  id            String    @id @default(uuid())
  subjectId     String
  topic         String
  questionText  String
  options       String    // Stored as JSON string
  correctOption String
  explanation   String
  difficulty    String    @default("MEDIUM") // EASY | MEDIUM | HARD

  subject       Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  quizQuestions QuizQuestion[]
  studentAnswers StudentQuestionAnswer[]

  @@map("questions")
}

model Quiz {
  id               String    @id @default(uuid())
  subjectId        String
  title            String
  description      String?
  timeLimitMinutes Int       @default(30)
  totalMarks       Int       @default(10)
  createdById      String

  subject          Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy        User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  
  quizQuestions    QuizQuestion[]
  assignments      Assignment[]
  quizAttempts     QuizAttempt[]

  @@map("quizzes")
}

model QuizQuestion {
  quizId     String
  questionId String
  marks      Int      @default(1)

  quiz       Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@id([quizId, questionId])
  @@map("quiz_questions")
}

model Assignment {
  id                  String    @id @default(uuid())
  quizId              String
  classroomId         String
  assignedToStudentId String?
  dueDate             DateTime
  createdAt           DateTime  @default(now())

  quiz                Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  classroom           Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  assignedToStudent   User?     @relation(fields: [assignedToStudentId], references: [id], onDelete: Cascade)
  
  quizAttempts        QuizAttempt[]

  @@map("assignments")
}

model QuizAttempt {
  id               String    @id @default(uuid())
  quizId           String
  assignmentId     String?
  studentId        String
  score            Float
  totalScore       Float
  timeSpentSeconds Int?
  submittedAt      DateTime  @default(now())

  quiz             Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  assignment       Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  student          User        @relation(fields: [studentId], references: [id], onDelete: Cascade)

  studentAnswers   StudentQuestionAnswer[]

  @@map("quiz_attempts")
}

model StudentQuestionAnswer {
  id             String      @id @default(uuid())
  attemptId      String
  studentId      String
  questionId     String
  selectedOption String
  isCorrect      Boolean

  attempt        QuizAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  student        User        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question       Question    @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("student_question_answers")
}

model RevisionPost {
  id          String   @id @default(uuid())
  subjectId   String
  createdById String
  title       String
  content     String   @default("")
  mediaUrl    String?
  mediaType   String?
  createdAt   DateTime @default(now())

  subject     Subject               @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  createdBy   User                  @relation("RevisionPostAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  interactions RevisionInteraction[]
  reviews     RevisionReview[]

  @@index([subjectId, createdAt])
  @@map("revision_posts")
}

model RevisionInteraction {
  id            String   @id @default(uuid())
  postId        String
  studentId     String
  liked         Boolean  @default(false)
  saved         Boolean  @default(false)
  priority      Boolean  @default(false)
  understanding String?
  updatedAt     DateTime @updatedAt

  post          RevisionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  student       User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([postId, studentId])
  @@map("revision_interactions")
}

model RevisionReview {
  id        String   @id @default(uuid())
  postId    String
  studentId String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post      RevisionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  student   User         @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([postId, studentId])
  @@map("revision_reviews")
}

model Meeting {
  id            String   @id @default(uuid())
  createdById   String
  recipientId   String?
  classroomId   String?
  audience      String
  title         String
  description   String   @default("")
  status        String   @default("SCHEDULED")
  scheduledAt   DateTime?
  preferredAt   DateTime?
  durationMins  Int      @default(30)
  location      String?
  meetingUrl    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  createdBy     User      @relation("MeetingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  recipient     User?     @relation("MeetingRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  classroom     Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@index([classroomId, scheduledAt])
  @@map("meetings")
}
